# To stop macOS's complaint about running bash
if [[ "$OSTYPE" == darwin* ]]; then
  export BASH_SILENCE_DEPRECATION_WARNING=1
  if [ -x /opt/homebrew/bin/brew ]; then
      eval "$(/opt/homebrew/bin/brew shellenv bash)"
  else
      echo "[WARN] Missing homebrew on a macos machine"
  fi
fi

# Native installer for Claude Code puts the binary here.
export PATH="$HOME/.local/bin:$PATH"

# Prompt: current directory, then the git branch (or short commit when
# detached) anywhere inside a repo, e.g. "~/dev/dotfiles (main) $ ".
# Colours are ANSI numbers, so they follow the terminal profile.
__prompt_git() {
  local ref
  ref=$(git symbolic-ref --short HEAD 2>/dev/null) ||
    ref=$(git rev-parse --short HEAD 2>/dev/null) || return
  printf ' (%s)' "$ref"
}
# The last command's exit status in red, e.g. " [127]", only when non-zero.
# It's saved in PROMPT_COMMAND because expanding $(__prompt_git) would
# overwrite $? before the prompt gets to it. Prepended once, so re-sourcing
# this file or other tools' PROMPT_COMMANDs don't clobber it.
__prompt_save_status() { __prompt_status=$?; }
__prompt_code() {
  [ "${__prompt_status:-0}" -ne 0 ] && printf ' [%s]' "$__prompt_status"
}
case "$PROMPT_COMMAND" in
  *__prompt_save_status*) ;;
  *) PROMPT_COMMAND="__prompt_save_status${PROMPT_COMMAND:+; $PROMPT_COMMAND}" ;;
esac
PS1='\[\e[34m\]\w\[\e[32m\]$(__prompt_git)\[\e[31m\]$(__prompt_code)\[\e[0m\] \$ '
